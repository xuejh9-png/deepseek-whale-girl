# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]

# 运行时产物
pet.port
*.tmp
用量报告.html.tmp

# 用量报告是【生成物】，而且里面有本机真实会话标题 / 项目路径
# （"用量最高的会话"那一栏）。公开仓库会暴露工作内容，所以不提交。
# 需要展示效果请用 docs/report.png 截图（默认视图不含会话名）。
用量报告.html

# 编译产物（desktop/build.sh 会重新生成）
desktop/WorkBuddyPet.app/

# 素材接入前的自动备份（本地保险，不进仓库）
assets/.backup/

# 编辑器
.vscode/
.idea/

# 外部交付包里的重体积文件（34MB，不入库；另有说明文档与单帧保留）
assets/run-12-final/*.zip
assets/run-12-final/*.html
assets/run-12-final/*.webp
assets/run-12-final/*.png

# 用量面板截图含真实用量数字，不入库（README 已撤掉引用）
docs/report.png
